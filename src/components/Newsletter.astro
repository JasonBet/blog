---
/**
 * Email signup.
 *
 * The form posts to /api/subscribe, a Vercel Function that holds the
 * Buttondown API key server-side. The key is never sent to the browser and
 * never appears in the built output — see api/subscribe.js and SECURITY.md.
 */
import { NEWSLETTER } from '@/consts';
---

{
  NEWSLETTER.enabled && (
    <section class="newsletter reveal" aria-labelledby="newsletter-heading">
      <div class="inner">
        <div class="copy">
          <h2 class="heading" id="newsletter-heading">{NEWSLETTER.heading}</h2>
          <p class="blurb">{NEWSLETTER.blurb}</p>
        </div>

        <form class="form" data-newsletter novalidate>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <div class="field">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              maxlength="254"
              placeholder="you@university.edu"
            />
            <button type="submit" data-newsletter-submit>Subscribe</button>
          </div>

          {/* Honeypot: a real person never fills this in; bots usually do. */}
          <div class="gotcha" aria-hidden="true">
            <label for="newsletter-company">Company</label>
            <input id="newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="status" data-newsletter-status role="status" aria-live="polite" />
        </form>
      </div>
    </section>
  )
}

<style>
  .newsletter {
    margin-top: 4rem;
    padding: 2rem 1.75rem 2.1rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bg-raised);
  }

  .inner {
    display: grid;
    gap: 1.4rem;
  }

  .heading {
    font-size: 1.22rem;
    font-weight: 580;
  }

  .blurb {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .field {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.62rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--bg);
    font-size: 0.92rem;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  input[type='email']:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  input[type='email']::placeholder {
    color: var(--text-faint);
  }

  button {
    padding: 0.62rem 1.3rem;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 520;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  button:hover:not(:disabled) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }
  button:active:not(:disabled) {
    transform: translateY(1px);
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    margin-top: 0.7rem;
    font-size: 0.84rem;
    min-height: 1.2em;
    color: var(--text-muted);
  }
  .status[data-state='ok'] {
    color: #4f7a6b;
  }
  .status[data-state='error'] {
    color: var(--accent);
  }

  /* Honeypot must be reachable by bots but invisible to people. */
  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr minmax(18rem, 22rem);
      align-items: center;
      gap: 2.5rem;
    }
  }
</style>

<script>
  import { claim, onReady } from '@/lib/client';

  /** Progressive enhancement: submits over fetch and reports inline. */
  function setupNewsletter() {
    const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
    if (!form || !claim(form)) return;

    const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-newsletter-submit]')!;

    const say = (message: string, state: 'ok' | 'error' | '') => {
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const company = String(data.get('company') ?? '');

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        say('That email address does not look right.', 'error');
        return;
      }

      submit.disabled = true;
      say('Subscribing…', '');

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, company }),
        });

        // A 404 means the function is not running — e.g. plain `astro dev`.
        if (response.status === 404) {
          say('Signup only works on the deployed site. Try `vercel dev` locally.', 'error');
          return;
        }

        const result = (await response.json().catch(() => ({}))) as {
          message?: string;
        };

        if (response.ok) {
          say(result.message ?? 'Subscribed. Check your inbox to confirm.', 'ok');
          form.reset();
        } else {
          say(result.message ?? 'Something went wrong. Please try again later.', 'error');
        }
      } catch {
        say('Network error. Please try again later.', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }

  onReady(setupNewsletter);
</script>
