---
/** The large hero card at the top of the homepage. */
import { Image } from 'astro:assets';
import { TOPICS } from '@/consts';
import { readTime, urlOf, type Post } from '@/lib/posts';
import FormattedDate from '@/components/FormattedDate.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const topic = TOPICS[post.data.topic];
const cover = post.data.cover;
---

<article class="featured reveal" style={`--topic-accent: ${topic.accent}`}>
  <a class="frame" href={urlOf(post)} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[560, 900, 1400]}
          sizes="(max-width: 62rem) 100vw, 62rem"
          loading="eager"
          class="cover"
        />
      ) : (
        <div class="cover cover--empty"></div>
      )
    }
  </a>

  <div class="text">
    <p class="eyebrow">
      <span class="dot" aria-hidden="true"></span>
      {topic.name}
    </p>

    <h2 class="title">
      <a class="title-link" href={urlOf(post)}>{post.data.title}</a>
    </h2>

    <p class="excerpt">{post.data.description}</p>

    <p class="meta">
      <FormattedDate date={post.data.pubDate} />
      <span class="sep" aria-hidden="true">·</span>
      {readTime(post)}
    </p>
  </div>
</article>

<style>
  .featured {
    display: grid;
    gap: 1.75rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }

  .frame {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg-sunken);
    aspect-ratio: 16 / 8;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* A slow, barely perceptible zoom on hover. */
    transition: transform 900ms var(--ease), filter var(--dur) var(--ease);
  }

  .cover--empty {
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--topic-accent) 16%, var(--bg-sunken)),
      var(--bg-sunken)
    );
  }

  .featured:hover .cover {
    transform: scale(1.02);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in oklab, var(--topic-accent) 72%, var(--text-muted));
  }

  .dot {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--topic-accent);
  }

  .title {
    margin-top: 0.7rem;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.6rem);
    letter-spacing: -0.022em;
  }

  .title-link {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size 420ms var(--ease);
    padding-bottom: 2px;
  }
  .title-link:hover,
  .title-link:focus-visible {
    background-size: 100% 2px;
  }

  .excerpt {
    margin-top: 0.85rem;
    max-width: 58ch;
    color: var(--text-muted);
    font-size: 1.02rem;
  }

  .meta {
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .sep {
    color: var(--text-faint);
  }

  @media (min-width: 58rem) {
    .featured {
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: 2.75rem;
    }
    .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
