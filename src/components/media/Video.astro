---
/**
 * Embedded video — YouTube, Vimeo, or a file you host yourself.
 *
 *   <Video youtube="dQw4w9WgXcQ" title="Raft in five minutes" />
 *   <Video vimeo="76979871" title="Lecture recording" />
 *   <Video src="/media/demo.mp4" title="Scheduler demo" poster={shot} />
 *
 * Third-party embeds are click-to-load: until the reader presses play, no
 * request is made to YouTube or Vimeo and no tracking cookie can be set.
 * YouTube is embedded through youtube-nocookie.com.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  youtube?: string;
  vimeo?: string;
  /** Self-hosted video file, e.g. /media/demo.mp4 (place it in /public). */
  src?: string;
  title: string;
  caption?: string;
  /** Poster frame. Required for self-hosted video, optional otherwise. */
  poster?: ImageMetadata | string;
  /** Aspect ratio as width/height. Defaults to 16/9. */
  ratio?: string;
}

const { youtube, vimeo, src, title, caption, poster, ratio = '16 / 9' } =
  Astro.props;

if (!youtube && !vimeo && !src) {
  throw new Error('<Video> needs one of: youtube, vimeo, or src.');
}

const embedUrl = youtube
  ? `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0&modestbranding=1`
  : vimeo
    ? `https://player.vimeo.com/video/${vimeo}?autoplay=1&dnt=1`
    : null;

const watchUrl = youtube
  ? `https://www.youtube.com/watch?v=${youtube}`
  : vimeo
    ? `https://vimeo.com/${vimeo}`
    : null;

// Fall back to YouTube's own thumbnail when no local poster is supplied.
const fallbackPoster = youtube
  ? `https://i.ytimg.com/vi/${youtube}/maxresdefault.jpg`
  : null;

const posterSrc = typeof poster === 'string' ? poster : null;
const posterImage = poster && typeof poster !== 'string' ? poster : null;
---

<figure class="video" style={`--ratio: ${ratio}`}>
  {
    embedUrl ? (
      <div class="frame">
        <button
          class="facade"
          type="button"
          data-video-embed={embedUrl}
          data-video-title={title}
          aria-label={`Play video: ${title}`}
        >
          {posterImage ? (
            <Image
              src={posterImage}
              alt=""
              widths={[480, 960, 1280]}
              sizes="(max-width: 46rem) 100vw, 46rem"
              loading="lazy"
              class="poster"
            />
          ) : (
            <img
              class="poster"
              src={posterSrc ?? fallbackPoster ?? ''}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}

          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>

          <span class="label">
            {title}
            <span class="hint">Loads from {youtube ? 'YouTube' : 'Vimeo'} when you press play</span>
          </span>
        </button>

        <noscript>
          <a class="noscript-link" href={watchUrl!} rel="noopener noreferrer">
            Watch “{title}” on {youtube ? 'YouTube' : 'Vimeo'}
          </a>
        </noscript>
      </div>
    ) : (
      <div class="frame">
        <video
          class="native"
          controls
          preload="metadata"
          playsinline
          poster={posterSrc ?? undefined}
        >
          <source src={src} />
          Your browser cannot play this video.
        </video>
      </div>
    )
  }

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video {
    margin-block: 2.25rem;
  }

  .frame {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--bg-sunken);
  }

  .frame :global(iframe),
  .native {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .facade {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: block;
  }

  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms var(--ease), filter var(--dur) var(--ease);
  }

  .facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(10 8 6 / 0.72) 0%,
      rgb(10 8 6 / 0.18) 42%,
      rgb(10 8 6 / 0.06) 100%
    );
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.9rem;
    height: 3.9rem;
    border-radius: 50%;
    background: rgb(250 249 246 / 0.94);
    color: #1a1a1a;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.28);
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .play svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
    margin-left: 2px;
  }

  .label {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.35;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
  }

  .hint {
    font-size: 0.72rem;
    font-weight: 400;
    opacity: 0.78;
  }

  .facade:hover .play {
    transform: scale(1.07);
    background: #fff;
  }
  .facade:hover .poster {
    transform: scale(1.03);
  }

  .noscript-link {
    position: absolute;
    inset: auto 1rem 1rem;
    z-index: 2;
    color: #fff;
    text-decoration: underline;
  }
</style>

<script>
  import { claim, onReady } from '@/lib/client';

  /** Swaps the click-to-load facade for the real iframe. */
  function setupVideos() {
    for (const button of document.querySelectorAll<HTMLElement>('[data-video-embed]')) {
      if (!claim(button)) continue;

      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = button.dataset.videoEmbed!;
        iframe.title = button.dataset.videoTitle ?? 'Embedded video';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.setAttribute('loading', 'lazy');
        // No same-origin: the embed gets no access to this document.
        iframe.setAttribute(
          'sandbox',
          'allow-scripts allow-same-origin allow-presentation allow-popups',
        );
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';

        button.replaceWith(iframe);
      });
    }
  }

  onReady(setupVideos);
</script>
