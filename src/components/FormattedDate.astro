---
interface Props {
  date: Date;
  /** "long" -> 24 August 2026, "short" -> Aug 24 */
  format?: 'long' | 'short';
  class?: string;
}

const { date, format = 'long', class: className } = Astro.props;

/*
 * Formatted in UTC on purpose. `pubDate: 2026-01-01` in frontmatter parses to
 * midnight UTC, so formatting in local time would render it as 31 December
 * for every reader west of Greenwich.
 */
const label = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: format === 'long' ? 'long' : 'short',
  year: format === 'long' ? 'numeric' : undefined,
  timeZone: 'UTC',
}).format(date);
---

<time datetime={date.toISOString()} class={className}>{label}</time>
