---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostListItem from '@/components/PostListItem.astro';
import { getPosts, collectTags, type Post } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Posts tagged ${tag}.`}
  wide
>
  <header class="page-head reveal">
    <p class="eyebrow">
      <a class="link" href="/posts/">Writing</a>
      <span aria-hidden="true">/</span>
      <span>Tag</span>
    </p>
    <h1 class="title">#{tag}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>

  <div class="list">
    {posts.map((post, i) => <PostListItem post={post} index={i} />)}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 2rem;
  }
  .eyebrow {
    display: flex;
    gap: 0.4rem;
  }
  .title {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .meta {
    margin-top: 1rem;
  }
  .list {
    border-top: 1px solid var(--rule);
  }
</style>
