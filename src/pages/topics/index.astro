---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TOPICS, type TopicKey } from '@/consts';
import { getPosts, urlOf } from '@/lib/posts';

const posts = await getPosts();

const topics = (Object.keys(TOPICS) as TopicKey[]).map((key) => {
  const matching = posts.filter((post) => post.data.topic === key);
  return { key, meta: TOPICS[key], count: matching.length, latest: matching[0] };
});
---

<BaseLayout
  title="Topics"
  description="The subjects this blog keeps circling back to."
  wide
>
  <header class="page-head reveal">
    <p class="eyebrow">Browse</p>
    <h1>Topics</h1>
    <p class="sub">Every post belongs to exactly one of these.</p>
  </header>

  <ul class="grid">
    {
      topics.map(({ key, meta, count, latest }, i) => (
        <li
          class="card reveal"
          style={`--topic-accent: ${meta.accent}; --reveal-delay: ${i * 70}ms`}
        >
          <a class="card-link" href={`/topics/${key}/`}>
            <span class="dot" aria-hidden="true" />
            <h2 class="name">{meta.name}</h2>
            <p class="desc">{meta.description}</p>
            <p class="count">
              {count} {count === 1 ? 'post' : 'posts'}
            </p>
          </a>

          {latest && (
            <p class="latest">
              Latest: <a class="link" href={urlOf(latest)}>{latest.data.title}</a>
            </p>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .page-head h1 {
    margin-top: 0.5rem;
  }
  .sub {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    list-style: none;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .card-link {
    flex: 1;
    /* Column flex so the post count can be pinned to the bottom, keeping
       the counts on one line across cards of unequal description length. */
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.6rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bg-raised);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .card-link:hover {
    border-color: color-mix(in oklab, var(--topic-accent) 50%, var(--rule));
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }

  .dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--topic-accent);
    margin-bottom: 0.9rem;
  }

  .name {
    font-size: 1.2rem;
    font-weight: 580;
  }

  .desc {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .count {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .latest {
    margin-top: 0.7rem;
    padding-left: 0.2rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>
