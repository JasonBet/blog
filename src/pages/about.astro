---
/**
 * Edit the prose below to say whatever you want. It is a plain Astro page,
 * so there is no frontmatter to satisfy — just write HTML.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, SOCIALS, TOPICS } from '@/consts';
---

<BaseLayout
  title="About"
  description={`About ${SITE.author} and this blog.`}
>
  <header class="page-head reveal">
    <p class="eyebrow">Hello</p>
    <h1>About</h1>
  </header>

  <div class="prose reveal">
    <p class="lede">
      I'm {SITE.author}, a graduate computer science student. This site is where
      I write up whatever I'm currently trying to understand.
    </p>

    <p>
      Most of what lands here starts as lecture notes or a problem set that
      refused to make sense until I wrote it out properly. Publishing it forces
      me to close the gaps I would otherwise skate over — and occasionally it
      turns out to be useful to someone else working through the same material.
    </p>

    <h2>What I write about</h2>
    <ul>
      {
        (Object.keys(TOPICS) as (keyof typeof TOPICS)[]).map((key) => (
          <li>
            <a href={`/topics/${key}/`}>{TOPICS[key].name}</a> —{' '}
            {TOPICS[key].description}
          </li>
        ))
      }
    </ul>

    <h2>How this site is built</h2>
    <p>
      Static pages generated by <a href="https://astro.build">Astro</a> from
      Markdown files, deployed on Vercel. Search runs entirely in your browser,
      analytics are cookieless and served from this domain, and no third-party
      code loads unless you
      press play on an embedded video or open the comments.
    </p>

    <h2>Get in touch</h2>
    <p>
      The best way to reach me is{' '}
      <a href={`mailto:${SOCIALS.email}`}>email</a>. You can also find my code on{' '}
      <a href={SOCIALS.github} rel="me noopener noreferrer">GitHub</a>, or
      subscribe to the <a href="/rss.xml">RSS feed</a> if you would rather not
      rely on me remembering to tell you when something new goes up.
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }
  .page-head h1 {
    margin-top: 0.5rem;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
  }
</style>
