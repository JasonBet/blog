---
/**
 * Full-text search over every post.
 *
 * The index is built by Pagefind after `astro build` (see the `build` script
 * in package.json) and served as static files from /pagefind. There is no
 * server, no third-party service and no API key involved.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search every post on this site."
  noindex
>
  <header class="page-head">
    <p class="eyebrow">Find</p>
    <h1>Search</h1>
  </header>

  <form class="search" role="search" data-search onsubmit="return false">
    <label class="sr-only" for="search-input">Search posts</label>
    <div class="field">
      <svg class="glass" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <line x1="15.4" y1="15.4" x2="20.5" y2="20.5"></line>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Try: consensus, gradient, complexity…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        data-search-input
      />
    </div>
  </form>

  <p class="status" data-search-status role="status" aria-live="polite"></p>

  <ol class="results" data-search-results></ol>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
  }
  .page-head h1 {
    margin-top: 0.5rem;
  }

  .field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .glass {
    position: absolute;
    left: 0.9rem;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.7;
    stroke-linecap: round;
    pointer-events: none;
  }

  input[type='search'] {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--bg-raised);
    font-size: 1rem;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  input[type='search']:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .status {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    min-height: 1.2em;
  }

  .results {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
  }

  .results :global(li) {
    border-top: 1px solid var(--rule);
  }

  .results :global(a) {
    display: block;
    padding-block: 1.35rem;
  }

  .results :global(.result-title) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 570;
    line-height: 1.3;
    transition: color var(--dur) var(--ease);
  }

  .results :global(a:hover .result-title) {
    color: var(--accent);
  }

  .results :global(.result-excerpt) {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .results :global(mark) {
    background: var(--accent-wash);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.15em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { claim, onReady } from '@/lib/client';

  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
  }
  interface PagefindResult {
    id: string;
    data: () => Promise<PagefindResultData>;
  }
  interface PagefindApi {
    options: (opts: Record<string, unknown>) => Promise<void>;
    search: (term: string) => Promise<{ results: PagefindResult[] }>;
  }

  let pagefind: PagefindApi | null = null;
  let loadFailed = false;

  async function loadPagefind(): Promise<PagefindApi | null> {
    if (pagefind || loadFailed) return pagefind;
    try {
      // Built by `pagefind` after the Astro build; absent during `astro dev`.
      // The path is held in a variable so neither TypeScript nor Vite tries
      // to resolve a file that only exists once the site has been built.
      const indexUrl = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ indexUrl)) as PagefindApi;
      await pagefind.options({ excerptLength: 28 });
      return pagefind;
    } catch {
      loadFailed = true;
      return null;
    }
  }

  function setupSearch() {
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const list = document.querySelector<HTMLElement>('[data-search-results]');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    if (!input || !list || !status || !claim(input)) return;

    let token = 0;
    let timer: number | undefined;

    async function run(term: string) {
      const mine = ++token;
      list!.replaceChildren();

      if (term.trim().length < 2) {
        status!.textContent = '';
        return;
      }

      const api = await loadPagefind();
      if (!api) {
        status!.textContent =
          'The search index is only built for the deployed site. Run `npm run build && npm run preview` to try it locally.';
        return;
      }

      status!.textContent = 'Searching…';
      const search = await api.search(term);
      if (mine !== token) return;

      const top = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      if (mine !== token) return;

      status!.textContent =
        top.length === 0
          ? `No posts match “${term}”.`
          : `${top.length} ${top.length === 1 ? 'result' : 'results'}`;

      for (const result of top) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = result.url;

        const title = document.createElement('span');
        title.className = 'result-title';
        title.textContent = result.meta.title ?? result.url;

        const excerpt = document.createElement('p');
        excerpt.className = 'result-excerpt';
        // Pagefind's excerpt contains only <mark> tags it generated itself.
        excerpt.innerHTML = result.excerpt;

        link.append(title, excerpt);
        li.append(link);
        list!.append(li);
      }
    }

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(input.value), 140);
    });

    // Support /search?q=term so results can be linked to.
    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      void run(initial);
    }

    input.focus();
  }

  onReady(setupSearch);
</script>
