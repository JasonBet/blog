# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development, and set the same values in
# the Vercel dashboard (Project -> Settings -> Environment Variables) for the
# deployed site.
#
# `.env` is git-ignored. Never commit real keys. If one ever does get
# committed, rotate it at the provider — removing the commit is not enough,
# because it is already in the repository's history.
# ---------------------------------------------------------------------------

# --- Server-side only. NEVER prefix these with PUBLIC_. -------------------
# Anything named PUBLIC_* is inlined into the browser bundle by Astro; these
# are read only inside api/subscribe.js, which runs on the server.

# Buttondown API key, from https://buttondown.com/settings/programming
BUTTONDOWN_API_KEY=

# Origins allowed to POST to /api/subscribe. Comma-separated.
# Leave blank to allow only the deployment's own origin (the usual case).
# ALLOWED_ORIGIN=https://your-domain.com,https://www.your-domain.com

# --- Build-time, public. ---------------------------------------------------
# Canonical site URL, used for RSS, sitemap and social cards. On Vercel this
# is derived automatically, so you only need it once you add a real domain.
# SITE_URL=https://your-domain.com
